<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext is allowed only for the local report-service stacks reachable via the Android
    emulator's loopback alias (10.0.2.2 → host's localhost). The default-config keeps cleartext
    blocked for everything else, so this scope creep cannot accidentally weaken HTTPS for
    api-qa.ia.de or any other host the SDK talks to.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
