{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDirs": [".", "../.."],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@demo/shared": ["../../tools/demo/index.ts"],
      "@ia-sdk/*": ["../../packages/*"],
      "@ia-sdk/ia-sdk": ["../../packages/ia-sdk/index.d.ts"]
    },
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "removeComments": false,
    "lib": ["ESNext"]
  }
}
