<Page 
  xmlns="http://schemas.nativescript.org/tns.xsd" 
  navigatingTo="navigatingTo" 
  backgroundSpanUnderStatusBar="false"
  backgroundColor="white" 
  color="black" >
    <Page.actionBar>
        <ActionBar title="{{ actionBarTitle }}" icon="" class="action-bar">
        </ActionBar>
    </Page.actionBar>
    
    <StackLayout>
        <Button 
            text="Launch Dermanostic Experience" 
            tap="{{ launchDermanosticExperience }}"
            style="margin-bottom:16" />
        <Button 
            text="Initialize" 
            tap="{{ initialize }}"
            style="margin-bottom:16" />
        <Button 
            text="Start Dashboard Activity" 
            tap="{{ startDashboardActivity }}"
            style="margin-bottom:16" />
        <Button
            text="Set Pharmacy ID 2163"
            tap="{{ setPharmacyId2163 }}"
            style="margin-bottom:16" />
        <Button
            text="Set Pharmacy ID 10041"
            tap="{{ setPharmacyId10041 }}"
            style="margin-bottom:16" />
        <Button
            text="Transfer SDK V1 Data"
            tap="{{ transferSDKv1UserData }}"
            style="margin-bottom:16" />
        <Button
            text="Clear Cart"
            tap="{{ clearCart }}"
            style="margin-bottom:16" />
        <Button
            text="Clear Pharmacy"
            tap="{{ clearPharmacy }}"
            style="margin-bottom:16" />
        <Button
            text="Logout" 
            tap="{{ logout }}"
            style="margin-bottom:16" />
    </StackLayout>
</Page>