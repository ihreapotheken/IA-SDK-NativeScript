<Page
  xmlns="http://schemas.nativescript.org/tns.xsd"
  navigatingTo="navigatingTo"
  actionBarHidden="true"
  backgroundSpanUnderStatusBar="false"
  class="demo-page">
  <GridLayout rows="auto, *">
    <!-- Brand, SDK version and backend, and whether the SDK is initialized. -->
    <StackLayout row="0" class="header">
      <GridLayout columns="*, auto">
        <StackLayout orientation="horizontal" verticalAlignment="bottom">
          <Label text="ia.de" class="brand-mark" />
          <Label text="AppSDK Demo" class="brand-product" />
        </StackLayout>
        <StackLayout col="1" orientation="horizontal" verticalAlignment="center" class="{{ isInitialized ? 'state state-ready' : 'state' }}">
          <Label class="{{ isInitialized ? 'state-dot state-dot-ready' : 'state-dot' }}" />
          <Label text="{{ isInitialized ? 'Initialized' : 'Not initialized' }}" class="{{ isInitialized ? 'state-text state-text-ready' : 'state-text' }}" />
        </StackLayout>
      </GridLayout>
      <Label text="{{ platformLine }}" class="platform" />
    </StackLayout>

    <ScrollView row="1">
      <Repeater items="{{ sections }}" class="content">
        <Repeater.itemTemplate>
          <StackLayout>
            <Label text="{{ title }}" class="section-title" />
            <StackLayout class="card">
              <Repeater items="{{ rows }}">
                <Repeater.itemTemplate>
                  <DockLayout
                    stretchLastChild="true"
                    class="{{ 'row' + (isFirst ? ' row-first' : '') + (isDimmed ? ' row-dimmed' : '') }}"
                    isUserInteractionEnabled="{{ !(isDimmed || isBusy) }}"
                    tap="{{ $parents['Page'].onRowTap }}">
                    <!-- A spinner while the row's call runs, otherwise a chevron. -->
                    <GridLayout dock="right" class="row-trailing">
                      <ActivityIndicator busy="{{ isBusy }}" visibility="{{ isBusy ? 'visible' : 'collapse' }}" class="row-spinner" />
                      <Label text="›" visibility="{{ isBusy ? 'collapse' : 'visible' }}" class="row-chevron" />
                    </GridLayout>
                    <StackLayout verticalAlignment="center">
                      <Label text="{{ title }}" class="row-title" textWrap="true" />
                      <Label text="{{ subtitle }}" class="row-subtitle" textWrap="true" />
                    </StackLayout>
                  </DockLayout>
                </Repeater.itemTemplate>
              </Repeater>
            </StackLayout>
          </StackLayout>
        </Repeater.itemTemplate>
      </Repeater>
    </ScrollView>
  </GridLayout>
</Page>
