<Page 
  xmlns="http://schemas.nativescript.org/tns.xsd" 
  navigatingTo="navigatingTo" 
  backgroundSpanUnderStatusBar="false"
  backgroundColor="white" 
  color="black" >
    <Page.actionBar>
        <ActionBar title="ia.de AppSDK Demo" icon="" class="action-bar">
        </ActionBar>
    </Page.actionBar>
    
    <StackLayout>
        <Button 
            text="Launch Dermanostic Experience" 
            tap="{{ launchDermanosticExperience }}"
            style="margin-bottom:16" />
        <Button 
            text="Initialize" 
            tap="{{ initialize }}"
            style="margin-bottom:16" />
        <Button 
            text="Start Dashboard Activity" 
            tap="{{ startDashboardActivity }}"
            style="margin-bottom:16" />
        <Button 
            text="Clear Cart" 
            tap="{{ clearCart }}"
            style="margin-bottom:16" />
        <Button 
            text="Logout" 
            tap="{{ logout }}"
            style="margin-bottom:16" />

        <Button 
            text="Show Pharmacy ID" 
            tap="{{ showPharmacyId }}"
            style="margin-bottom:16" />
    </StackLayout>
</Page>